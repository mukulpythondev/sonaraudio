# Server-only. Never prefix these with NEXT_PUBLIC_.
FISH_API_KEY=
# An available voice/model ID from your Fish Audio account, not the TTS engine name.
FISH_REFERENCE_ID=
# Confirm model access with the organizers. No automatic model fallback.
FISH_MODEL=drama-3
# Scene studio always uses Drama 3; choose two distinct authorized voices.
FISH_VOICE_A=
FISH_VOICE_B=
# Optional: original scripts and manual editing work without Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Workers AI takes precedence over Gemini when either Cloudflare credential is configured.
# Use a token scoped to this account with Workers AI Read and Edit permissions.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct
